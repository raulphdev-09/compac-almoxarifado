# Exporte variáveis no processo; o aplicativo não lê .env automaticamente.
COMPAC_DB=.data/compac.db
COMPAC_TIMEZONE=America/Sao_Paulo
# Na hospedagem gratuita, guarde a URL do Neon nas configurações seguras da Render.
# Nunca preencha nem envie uma URL com senha para o GitHub.
# DATABASE_URL=
# COMPAC_REQUIRE_POSTGRES=1
# Em produção HTTPS, use 1.
COMPAC_COOKIE_SECURE=0
# Configure um valor secreto nas configurações da hospedagem antes de publicar.
# COMPAC_SETUP_TOKEN=
# Para domínio personalizado (sem barra final):
# COMPAC_PUBLIC_URL=https://seu-dominio
